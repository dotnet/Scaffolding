<#@ template hostSpecific="true" linePragmas="false" #>
<#@ parameter type="Microsoft.DotNet.Tools.Scaffold.AspNet.Models.HealthcareTrackerModel" name="Model" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Linq" #>

@page "/healthcare-tracker"
<# if (Model.HasMainLayout) { #>
@layout MainLayout
<# } #>
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Healthcare Tracker</PageTitle>

<div class="healthcare-dashboard">

    <div class="dashboard-header">

        <div>
            <h1 class="dashboard-title">Healthcare Tracker</h1>
            <p class="dashboard-description">
                Explore a healthcare management experience powered by Syncfusion Blazor Toolkit, featuring vital monitoring, appointment scheduling, and wellness tracking.
            </p>
        </div>

        <div class="header-actions">

            <SfButton CssClass="refresh-btn"
                    OnClick="RefreshPage">
                ↻ Refresh
            </SfButton>

            <SfTooltip Position="Position.BottomCenter" OpensOn="Click">

                <ChildContent>
                    <SfButton CssClass="icon-btn">
                        <span class="icon-symbol">ⓘ</span>
                    </SfButton>
                </ChildContent>

                <ContentTemplate>

                    <div class="health-tooltip">

                        <div class="tooltip-title">
                            Health Summary
                        </div>

                        <div class="tooltip-row">
                            <span>❤️ Heart Rate</span>
                            <strong>@HeartRate bpm</strong>
                        </div>

                        <div class="tooltip-row">
                            <span>🩺 Blood Pressure</span>
                            <strong>@Systolic/@Diastolic</strong>
                        </div>

                        <div class="tooltip-row">
                            <span>💧 SpO₂</span>
                            <strong>@SpO2%</strong>
                        </div>

                        <div class="tooltip-row">
                            <span>🌡 Temperature</span>
                            <strong>@Temperature°F</strong>
                        </div>

                    </div>

                </ContentTemplate>

            </SfTooltip>

            <SfButton CssClass="icon-btn" OnClick="ToggleNotifications">
                <span class="icon-symbol">🔔</span>
            </SfButton>

        </div>

        @if (ShowNotificationPopup)
        {
            <div class="notification-popup">
                <div class="popup-title">Notifications</div>
                <div class="popup-item">Appointment scheduled for tomorrow</div>
                <div class="popup-item">Daily health summary available</div>
                <div class="popup-item">All vitals are within normal limits</div>
            </div>
        }
    </div>

    <!-- KPI Cards -->

    <div class="metrics-grid">

        <div class="health-card">
            <div class="health-card-content">

                <div class="metric-icon heart-icon">
                    ❤️
                </div>

                <div>
                    <div class="metric-label">Heart Rate</div>
                    <div class="metric-value">72 bpm</div>
                    <div class="metric-improvement">
                        ↓ 3 bpm from yesterday
                    </div>
                </div>

            </div>
        </div>

        <div class="health-card">

            <div class="health-card-content">

                <div class="metric-icon bp-icon">
                    🩺
                </div>

                <div>
                    <div class="metric-label">Blood Pressure</div>
                    <div class="metric-value">120 / 80 mmHg</div>
                    <div class="metric-status">Normal</div>
                </div>

            </div>

        </div>

        <div class="health-card">

            <div class="health-card-content">

                <div class="metric-icon spo2-icon">
                    💧
                </div>

                <div>
                    <div class="metric-label">SpO₂</div>
                    <div class="metric-value">98%</div>
                    <div class="metric-status">Normal</div>
                </div>

            </div>

        </div>

        <div class="health-card">

            <div class="health-card-content">

                <div class="metric-icon temp-icon">
                    🌡
                </div>

                <div>
                    <div class="metric-label">Temperature</div>
                    <div class="metric-value">98.6 °F</div>
                    <div class="metric-status">Normal</div>
                </div>

            </div>

        </div>

    </div>

    <!-- Content Row -->

    <div class="content-grid">

        <div class="dashboard-card chart-card">

            <div class="dashboard-card-header">
                Heart Rate Trend
            </div>

            <div class="dashboard-card-body">

                <div class="chart-toolbar">

                    <SfButtonGroup>

                        <SfButton CssClass="e-primary" Disabled="false">
                            7 Days
                        </SfButton>

                        <SfButton Disabled="true">
                            30 Days
                        </SfButton>

                        <SfButton Disabled="true">
                            3 Months
                        </SfButton>

                    </SfButtonGroup>

                </div>

                <SfChart>

                    <ChartPrimaryXAxis
                        ValueType="Syncfusion.Blazor.Toolkit.ValueType.Category">
                    </ChartPrimaryXAxis>

                    <ChartPrimaryYAxis
                        Minimum="40"
                        Maximum="120"
                        Interval="20"
                        Title="BPM">
                    </ChartPrimaryYAxis>

                    <ChartSeries DataSource="@HeartRateData"
                                 XName="X"
                                 YName="Y"
                                 Type="Syncfusion.Blazor.Toolkit.ChartSeriesType.Area"
                                 Name="Heart Rate"
                                 Fill="#bad1f3">

                        <ChartMarker Visible="true"
                                     IsFilled="true">
                        </ChartMarker>

                    </ChartSeries>

                </SfChart>

            </div>

        </div>

        <div class="dashboard-card schedule-card">

            <div class="dashboard-card-header">
                Checkup Schedule
            </div>

            <div class="dashboard-card-body">

                <div class="form-section">

                    <label>Select Date</label>

                    <SfDatePicker @bind-Value="SelectedDate">
                    </SfDatePicker>

                </div>

                <div class="form-section">

                    <label>Select Time</label>

                    <SfTimePicker @bind-Value="SelectedTime">
                    </SfTimePicker>

                </div>

                <div class="form-section">

                    <label>Visit Notes</label>

                    <SfTextArea
                        Width="100%"
                        Rows="4"
                        Placeholder="Symptoms, concerns, or notes for the doctor..."
                        @bind-Value="HealthNotes">
                    </SfTextArea>

                </div>

                <SfButton CssClass="e-primary w-100" OnClick="BookVisit">
                    Book Visit
                </SfButton>
                @if (!string.IsNullOrWhiteSpace(AppointmentMessage))
                {
                    <div class="appointment-message">
                        @AppointmentMessage
                    </div>
                }
            </div>

        </div>

    </div>

<div class="bottom-grid">
    <!-- Bottom Cards -->

    <div class="dashboard-card">

        <div class="dashboard-card-header">
            Daily Health Goals
        </div>

        <div class="dashboard-card-body">

            <label>Steps Goal (per day)</label>

            <SfNumericTextBox TValue="int"
                            @bind-Value="StepsGoal">
            </SfNumericTextBox>

            <div class="mt-3">
                <label>Completed Steps</label>

                <SfNumericTextBox TValue="int"
                                @bind-Value="StepsCompleted">
                </SfNumericTextBox>
            </div>

            <div class="mt-3">
                Goal Completion:
                <strong>@GoalPercentage%</strong>
            </div>

            <SfCheckBox TChecked="bool"
                        Label="Water Intake"
                        @bind-Checked="WaterIntake">
            </SfCheckBox>

            <SfCheckBox TChecked="bool"
                        Label="Exercise"
                        @bind-Checked="Exercise">
            </SfCheckBox>

            <SfCheckBox TChecked="bool"
                        Label="Sleep Tracking"
                        @bind-Checked="SleepTracking">
            </SfCheckBox>

        </div>

    </div>

    <div class="dashboard-card">

        <div class="dashboard-card-header">
            Monitoring Settings
        </div>

        <div class="dashboard-card-body">

            <div class="section-title">
                View Summary
            </div>

            <div class="radio-row">

                <SfRadioButton Label="Daily"
                            Value= "EveryDay"
                            Name="Summary"
                            @bind-Checked="chooseOption">
                </SfRadioButton>

                <SfRadioButton Label="Weekly"
                            Name="Summary"
                            Value= "EveryWeek"
                            @bind-Checked="chooseOption">
                </SfRadioButton>

            </div>

            <div class="current-mode">
                Current Summary:
                <strong>
                    @(chooseOption == "EveryDay"
                        ? "Daily"
                        : "Weekly")
                </strong>
            </div>

            <hr />

            <div class="notification-row">

                <div>

                    <div class="section-title">
                        Notifications
                    </div>

                    <div class="section-caption">
                        Receive health updates
                    </div>

                </div>

                <SfSwitch @bind-Checked="NotificationsEnabled">
                </SfSwitch>
            </div>

        </div>

    </div>

</div>

    <div class="health-footer">
        ❤️ Stay consistent, stay healthy! |
        All data is for personal reference only.
    </div>

</div>

@code {
    private bool NotificationsEnabled = true;
    private bool ShowNotificationPopup;

    private string chooseOption = "EveryWeek";

    private string HealthNotes = string.Empty;

    private int HeartRate = 72;
    private int Systolic = 120;
    private int Diastolic = 80;
    private int SpO2 = 98;
    private double Temperature = 98.6;

    private int StepsGoal = 8000;
    private int StepsCompleted = 4500;

    private DateTime? SelectedDate = DateTime.Today;

    private DateTime? SelectedTime =
        DateTime.Today.AddHours(10).AddMinutes(30);

    private string AppointmentMessage = "";

    private bool WaterIntake = true;
    private bool Exercise = true;
    private bool SleepTracking;

    private void RefreshPage()
    {
        Navigation.NavigateTo(
            Navigation.Uri,
            forceLoad: true);
    }

    private void ToggleNotifications()
    {
        ShowNotificationPopup = !ShowNotificationPopup;
    }

    private void BookVisit()
    {
        if (SelectedDate == null || SelectedTime == null)
        {
            AppointmentMessage = "Select date and time";
            return;
        }

        AppointmentMessage =
            $"Visit booked for {SelectedDate:dd MMM yyyy} at {SelectedTime:hh:mm tt}";
    }

    private double GoalPercentage =>
        StepsGoal == 0
            ? 0
            : Math.Round((double)StepsCompleted / StepsGoal * 100, 0);

    public class HealthPoint
    {
        public string X { get; set; } = string.Empty;
        public double Y { get; set; }
    }

    public List<HealthPoint> HeartRateData =
    [
        new(){ X="Mon", Y=76 },
        new(){ X="Tue", Y=82 },
        new(){ X="Wed", Y=68 },
        new(){ X="Thu", Y=91 },
        new(){ X="Fri", Y=81 },
        new(){ X="Sat", Y=78 },
        new(){ X="Sun", Y=80 }
    ];

}
<style>
.healthcare-dashboard {
    background: #f1f5f9;
    min-height: 100vh;
    padding: 24px;
}
.dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    margin-bottom: 24px;
}
.dashboard-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
    color: #0f172a;
}
.dashboard-description { color: #64748b; margin-bottom: 0; }
.header-actions { display: flex; align-items: center; gap: 12px; }
.icon-btn {
    width: 42px; min-width: 42px; height: 42px; border-radius: 8px;
}
.refresh-btn { min-width: 120px; height: 42px; border-radius: 8px; }
.icon-symbol { font-size: 1.125rem; }
.notification-popup {
    position: absolute; top: 72px; right: 0; width: 320px;
    background: #fff; border: 1px solid #dbe4ee; border-radius: 12px;
    padding: 16px; box-shadow: 0 10px 30px rgba(0,0,0,.12); z-index: 1000;
}
.popup-title { font-size: 0.95rem; font-weight: 600; margin-bottom: 12px; }
.popup-item { padding: 10px 0; border-bottom: 1px solid #f1f5f9; }
.popup-item:last-child { border-bottom: none; }
.metrics-grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 20px; margin-bottom: 24px;
}
.health-card, .dashboard-card {
    background: #fff; border: 1px solid #dbe4ee; border-radius: 12px;
    box-shadow: 0 1px 2px rgba(15,23,42,.04);
}
.health-card {
    padding: 20px 24px; min-height: 140px;
    display: flex; align-items: center;
}
.health-card-content {
    display: flex; align-items: center; gap: 18px; width: 100%;
}
.metric-icon {
    width: 64px; height: 64px; border-radius: 50%;
    display: flex; justify-content: center; align-items: center;
    font-size: 1.75rem; flex-shrink: 0;
}
.heart-icon { background: #fef2f2; }
.bp-icon { background: #eff6ff; }
.spo2-icon { background: #ecfdf5; }
.temp-icon { background: #fff7ed; }
.metric-label { font-size: 1rem; color: #64748b; }
.metric-value {
    font-size: 1.75rem; font-weight: 700; color: #0f172a; margin: 4px 0;
}
.metric-status { color: #2563eb; margin-top: 4px; }
.metric-improvement { color: #22c55e; margin-top: 4px; }
.content-grid {
    display: grid; grid-template-columns: 3fr 1fr;
    gap: 20px; align-items: start; margin-bottom: 20px;
}
.dashboard-card-header {
    padding: 20px 24px; border-bottom: 1px solid #f1f5f9;
    font-weight: 600; font-size: 1.15rem;
}
.dashboard-card-body { padding: 24px; }
.chart-toolbar {
    display: flex; justify-content: flex-end; margin-bottom: 16px;
}
.chart-card .e-chart { height: 360px !important; }
.schedule-card .dashboard-card-body {
    display: flex; flex-direction: column; gap: 16px;
}
.form-section { margin-bottom: 4px; }
.form-section label {
    display: block; margin-bottom: 6px; font-weight: 500;
}
.appointment-message {
    color: #104810; background: #c4f7c4;
    padding: 8px 12px; border-radius: 8px; margin-top: 8px;
}
.bottom-grid {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 20px; margin-top: 20px;
}
.bottom-grid .dashboard-card {
    min-height: 300px; display: flex; flex-direction: column;
}
.bottom-grid .dashboard-card-body { flex: 1; }
.section-title { font-weight: 500; margin-bottom: 6px; }
.section-caption { color: #64748b; font-size: 0.8rem; }
.radio-row { display: flex; gap: 24px; margin: 12px 0 16px; }
.notification-row {
    display: flex; justify-content: space-between;
    align-items: center; margin-top: 20px;
}
.current-mode { margin-top: 8px; font-size: 0.85rem; color: #64748b; }
.health-footer {
    text-align: center; color: #64748b;
    margin-top: 24px; padding-top: 12px; font-size: 0.9rem;
}
@@media (max-width: 992px) {
    .metrics-grid,
    .content-grid,
    .bottom-grid { grid-template-columns: 1fr; }
}
</style>
