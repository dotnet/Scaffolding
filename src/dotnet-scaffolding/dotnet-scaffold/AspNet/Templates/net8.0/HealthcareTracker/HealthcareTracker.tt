<#@ template hostSpecific="true" linePragmas="false" #>
<#@ parameter type="Microsoft.DotNet.Tools.Scaffold.AspNet.Models.HealthcareTrackerModel" name="Model" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Linq" #>

@page "/healthcare-tracker"
<# if (Model.HasMainLayout) { #>
@layout MainLayout
<# } #>
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Healthcare Tracker</PageTitle>

<div class="healthcare-dashboard">

    <div class="dashboard-header">

        <div>
            <h1 class="dashboard-title">Healthcare Tracker</h1>
            <p class="dashboard-subtitle">
                Monitor your daily health and wellness.
            </p>
        </div>

        <div class="header-actions">

            <SfButton CssClass="refresh-btn"
                    OnClick="RefreshPage">
                ↻ Refresh
            </SfButton>

            <SfButton CssClass="icon-btn">
                <span class="icon-symbol">ⓘ</span>
            </SfButton>

            <SfButton CssClass="icon-btn">
                <span class="icon-symbol">🔔</span>
            </SfButton>

            <SfSwitch @bind-Checked="IsDarkMode">
            </SfSwitch>

        </div>

    </div>

    <!-- KPI Cards -->

    <div class="metrics-grid">

        <div class="health-card">
            <div class="health-card-content">

                <div class="metric-icon heart-icon">
                    ❤️
                </div>

                <div>
                    <div class="metric-label">Heart Rate</div>
                    <div class="metric-value">72 bpm</div>
                    <div class="metric-improvement">
                        ↓ 3 bpm from yesterday
                    </div>
                </div>

            </div>
        </div>

        <div class="health-card">

            <div class="health-card-content">

                <div class="metric-icon bp-icon">
                    🩺
                </div>

                <div>
                    <div class="metric-label">Blood Pressure</div>
                    <div class="metric-value">120 / 80 mmHg</div>
                    <div class="metric-status">Normal</div>
                </div>

            </div>

        </div>

        <div class="health-card">

            <div class="health-card-content">

                <div class="metric-icon spo2-icon">
                    💧
                </div>

                <div>
                    <div class="metric-label">SpO₂</div>
                    <div class="metric-value">98%</div>
                    <div class="metric-status">Normal</div>
                </div>

            </div>

        </div>

        <div class="health-card">

            <div class="health-card-content">

                <div class="metric-icon temp-icon">
                    🌡
                </div>

                <div>
                    <div class="metric-label">Temperature</div>
                    <div class="metric-value">98.6 °F</div>
                    <div class="metric-status">Normal</div>
                </div>

            </div>

        </div>

    </div>

    <!-- Content Row -->

    <div class="content-grid">

        <div class="dashboard-card chart-card">

            <div class="dashboard-card-header">
                Heart Rate Trend
            </div>

            <div class="dashboard-card-body">

                <div class="chart-toolbar">

                    <SfButtonGroup>

                        <SfButton CssClass="e-primary">
                            7 Days
                        </SfButton>

                        <SfButton>
                            30 Days
                        </SfButton>

                        <SfButton>
                            3 Months
                        </SfButton>

                    </SfButtonGroup>

                </div>

                <SfChart>

                    <ChartPrimaryXAxis
                        ValueType="Syncfusion.Blazor.Toolkit.ValueType.Category">
                    </ChartPrimaryXAxis>

                    <ChartPrimaryYAxis
                        Minimum="40"
                        Maximum="120"
                        Interval="20"
                        Title="BPM">
                    </ChartPrimaryYAxis>

                    <ChartSeries DataSource="@HeartRateData"
                                 XName="X"
                                 YName="Y"
                                 Type="Syncfusion.Blazor.Toolkit.ChartSeriesType.Area"
                                 Name="Heart Rate"
                                 Fill="#bad1f3"
                                 Border="@(new ChartSeriesBorder
                                    {
                                        Width = 2,
                                        Color = "#4373bb"
                                    })">

                        <ChartMarker Visible="true"
                                     IsFilled="true">
                        </ChartMarker>

                    </ChartSeries>

                </SfChart>

            </div>

        </div>

        <div class="dashboard-card schedule-card">

            <div class="dashboard-card-header">
                Checkup Schedule
            </div>

            <div class="dashboard-card-body">

                <div class="form-section">

                    <label>Select Date</label>

                    <SfDatePicker @bind-Value="SelectedDate">
                    </SfDatePicker>

                </div>

                <div class="form-section">

                    <label>Select Time</label>

                    <SfTimePicker @bind-Value="SelectedTime">
                    </SfTimePicker>

                </div>

                <SfButton CssClass="e-primary w-100">
                    Book Visit
                </SfButton>

            </div>

        </div>

    </div>

<div class="bottom-grid">
    <!-- Bottom Cards -->

    <div class="dashboard-card">

        <div class="dashboard-card-header">
            Daily Health Goals
        </div>

        <div class="dashboard-card-body">

            <label>Steps Goal (per day)</label>

            <SfNumericTextBox TValue="int"
                            Value="8000">
            </SfNumericTextBox>

            <div class="mt-3">
                <SfCheckBox TChecked="bool"
                            Label="Water Intake"
                            Checked="true">
                </SfCheckBox>
            </div>

            <div class="mt-2">
                <SfCheckBox TChecked="bool"
                            Label="Exercise"
                            Checked="true">
                </SfCheckBox>
            </div>

            <div class="mt-2">
                <SfCheckBox TChecked="bool"
                            Label="Sleep Tracking">
                </SfCheckBox>
            </div>

        </div>

    </div>

    <div class="dashboard-card">

        <div class="dashboard-card-header">
            Monitoring Settings
        </div>

        <div class="dashboard-card-body">

            <div class="section-title">
                View Summary
            </div>

            <div class="radio-row">

                <SfRadioButton Label="Daily"
                            Value= "EveryDay"
                            Name="Summary"
                            @bind-Checked="chooseOption">
                </SfRadioButton>

                <SfRadioButton Label="Weekly"
                            Name="Summary"
                            Value= "EveryWeek"
                            @bind-Checked="chooseOption">
                </SfRadioButton>

            </div>

            <hr />

            <div class="notification-row">

                <div>

                    <div class="section-title">
                        Notifications
                    </div>

                    <div class="section-caption">
                        Receive health updates
                    </div>

                </div>

                <SfSwitch Checked="true">
                </SfSwitch>

            </div>

        </div>

    </div>

    <div class="dashboard-card">

        <div class="dashboard-card-header">
            Health Notes
        </div>

        <div class="dashboard-card-body">

            <SfTextArea
                Width="100%"
                Placeholder="How are you feeling today?"
                Rows="5">
            </SfTextArea>

        </div>

    </div>
</div>

    <div class="health-footer">
        ❤️ Stay consistent, stay healthy! |
        All data is for personal reference only.
    </div>

</div>

@code {
    private bool IsDarkMode;

    private string chooseOption = "EveryWeek";

    private void RefreshPage()
    {
        Navigation.NavigateTo(
            Navigation.Uri,
            forceLoad: true);
    }

    private DateTime? SelectedDate = DateTime.Today;

    private DateTime? SelectedTime =
        DateTime.Today.AddHours(10).AddMinutes(30);

    public class HealthPoint
    {
        public string X { get; set; } = string.Empty;
        public double Y { get; set; }
    }

    public List<HealthPoint> HeartRateData =
    [
        new(){ X="Mon", Y=76 },
        new(){ X="Tue", Y=82 },
        new(){ X="Wed", Y=68 },
        new(){ X="Thu", Y=91 },
        new(){ X="Fri", Y=81 },
        new(){ X="Sat", Y=78 },
        new(){ X="Sun", Y=80 }
    ];

}
<style>
.healthcare-dashboard {
    background: #f1f5f9;
    min-height: 100vh;
    padding: 24px;
}

.schedule-card {
    height: 520px;
}

.dashboard-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 24px;
    align-items: center;
}

.dashboard-title {
    font-size: 42px;
    font-weight: 700;
    margin-bottom: 6px;
    color: #0f172a;
}

.dashboard-subtitle {
    color: #64748b;
    font-size: 18px;
}

.metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 24px;
}

.health-card,
.dashboard-card {
    background: #fff;
    border: 1px solid #dbe4ee;
    border-radius: 12px;
    box-shadow: 0 1px 2px rgba(15,23,42,.04);
}

.health-card {
    padding: 20px 24px;
    height: 120px;
    display: flex;
    align-items: center;
}


.health-card-content {
    display: flex;
    align-items: center;
    gap: 18px;
}

.metric-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 28px;
}

.heart-icon {
    background: #fef2f2;
}

.bp-icon {
    background: #eff6ff;
}

.spo2-icon {
    background: #ecfdf5;
}

.temp-icon {
    background: #fff7ed;
}

.metric-label {
    font-size: 18px;
    color: #64748b;
}

.metric-value {
    font-size: 28px;
    font-weight: 700;
    color: #0f172a;
}

.metric-status {
    color: #2563eb;
    margin-top: 8px;
}

.metric-improvement {
    color: #22c55e;
    margin-top: 8px;
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
}

.icon-btn {
    width: 42px;
    height: 42px;
    min-width: 42px;
    border-radius: 8px;
}

.refresh-btn {
    min-width: 120px;
    border-radius: 8px;
    width: 42px;
    height: 42px;
}

.content-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 20px;
    margin-bottom: 24px;
}

.health-card {
    display: flex;
    align-items: center;
}

.health-card-content {
    width: 100%;
}

.bottom-grid {
    display: grid;
    grid-template-columns: 1.5fr 1.3fr 1.4fr;
    gap: 20px;
    align-items: stretch;
    margin-top: 24px;
}

.bottom-grid .dashboard-card {
    height: 300px;
}

.bottom-grid .dashboard-card {
    min-height: 300px;
    display: flex;
    flex-direction: column;
}

.bottom-grid .dashboard-card-body {
    flex: 1;
}

.bottom-grid .e-textarea {
    width: 100% !important;
    height: 140px !important;
}

.notification-row {
    margin-top: 24px;
}

.radio-row {
    margin-top: 12px;
    margin-bottom: 20px;
}

.dashboard-card-header {
    padding: 20px 24px;
    border-bottom: 1px solid #f1f5f9;
    font-weight: 600;
    font-size: 20px;
}

.chart-toolbar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 20px;
}

.schedule-card .dashboard-card-body {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.dashboard-card-body {
    padding: 24px;
}

.chart-card {
    height: 500px;
}

.chart-card .e-chart {
    height: 360px !important;
}

.schedule-card .dashboard-card-body {
    justify-content: flex-start;
}

.schedule-card .e-btn {
    margin-top: 12px;
}

.chart-card .dashboard-card-body {
    height: calc(100% - 72px);
    overflow: hidden;
}

.form-section {
    margin-bottom: 20px;
}

.health-footer {
    text-align: center;
    color: #64748b;
    margin-top: 24px;
    font-size: 15px;
}

.radio-row {
    display: flex;
    gap: 24px;
    margin-top: 8px;
}

.notification-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.section-title {
    font-weight: 500;
    margin-bottom: 6px;
}

.section-caption {
    color: #64748b;
    font-size: 13px;
}

.icon-symbol {
    font-size: 18px;
}
</style>
