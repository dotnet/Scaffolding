<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(StandardTestTfms)</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageDownload Include="Microsoft.DotNet.Web.ProjectTemplates.10.0" Version="[10.0.12]" />
    <PackageDownload Include="Microsoft.DotNet.Web.ProjectTemplates.11.0" Version="[11.0.0-rc.2.26473.103]" />
    <Content Include="$(NuGetPackageRoot)microsoft.dotnet.web.projecttemplates.10.0\10.0.12\microsoft.dotnet.web.projecttemplates.10.0.10.0.12.nupkg"
             Link="BaselineTemplates\net10.0.nupkg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)microsoft.dotnet.web.projecttemplates.11.0\11.0.0-rc.2.26473.103\microsoft.dotnet.web.projecttemplates.11.0.11.0.0-rc.2.26473.103.nupkg"
             Link="BaselineTemplates\net11.0.nupkg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src\dotnet-scaffolding\dotnet-scaffold\dotnet-scaffold.csproj" />
    <ProjectReference Include="$(RepoRoot)src\dotnet-scaffolding\Microsoft.DotNet.Scaffolding.Core\Microsoft.DotNet.Scaffolding.Core.csproj" />
    <ProjectReference Include="$(RepoRoot)src\dotnet-scaffolding\Microsoft.DotNet.Scaffolding.Internal\Microsoft.DotNet.Scaffolding.Internal.csproj" />
    <ProjectReference Include="$(RepoRoot)src\Shared\Microsoft.DotNet.Scaffolding.Shared\Microsoft.DotNet.Scaffolding.Shared.csproj" />
  </ItemGroup>

</Project>
